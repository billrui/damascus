# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql://posuser:secret@localhost:5432/royalpalm
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── CORS ────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ─── Business ────────────────────────────────────────────────
BUSINESS_NAME=Damascus Hotel
BUSINESS_ADDRESS=Kericho, Kenya
BUSINESS_TEL=0793935384
BUSINESS_VAT=P000111222X

# ─── Receipts ────────────────────────────────────────────────
RECEIPT_STORAGE_PATH=./storage/receipts
